\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Directed acyclic graph of the complete generative model. Shaded nodes are observed; unshaded nodes are latent. $Z_p, W$: structured prior mean $Z_p^\top W$ anchoring $X_p$ to draft position, height, and positional role. $\nu ^k, w^k$: weight vectors for peak age $t^*_{pk}$ and peak value $f^*_{pk}$. $\beta $: HSGP spectral weights for the concave trajectory $f^k(X_p,t)$. $\rho ^k, \sigma ^k_{AR}$: AR(1) parameters for the player-metric residual $r^k_{pt}$. $F_m, L_k$: injury-type factors and metric loadings for the injury offset $\tau ^k_{ptm}$. $Y^k_{pt}$: observed statistic (Gaussian, Negative-Binomial, Beta, or Beta-Binomial, per Table~\ref {tab:metric_description}).}}{16}{figure.caption.5}\protected@file@percent }
\newlabel{fig:graphical_model}{{2}{16}{Directed acyclic graph of the complete generative model. Shaded nodes are observed; unshaded nodes are latent. $Z_p, W$: structured prior mean $Z_p^\top W$ anchoring $X_p$ to draft position, height, and positional role. $\nu ^k, w^k$: weight vectors for peak age $t^*_{pk}$ and peak value $f^*_{pk}$. $\beta $: HSGP spectral weights for the concave trajectory $f^k(X_p,t)$. $\rho ^k, \sigma ^k_{AR}$: AR(1) parameters for the player-metric residual $r^k_{pt}$. $F_m, L_k$: injury-type factors and metric loadings for the injury offset $\tau ^k_{ptm}$. $Y^k_{pt}$: observed statistic (Gaussian, Negative-Binomial, Beta, or Beta-Binomial, per Table~\ref {tab:metric_description})}{figure.caption.5}{}}
