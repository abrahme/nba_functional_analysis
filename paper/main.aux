\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Hold-out coverage by metric does not seem to significantly differ by number of in-sample seasons available. Note that the lone observation for number of seasons is LeBron James, which we fail to project well as his career arc is anomalous.\relax }}{68}{figure.caption.65}\protected@file@percent }
\newlabel{fig:coverage_minutes}{{19}{68}{Hold-out coverage by metric does not seem to significantly differ by number of in-sample seasons available. Note that the lone observation for number of seasons is LeBron James, which we fail to project well as his career arc is anomalous.\relax }{figure.caption.65}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces This plot illustrates a clustered correlation matrix of the metrics, according to max values players accrued over their careers. \relax }}{69}{figure.caption.66}\protected@file@percent }
\newlabel{fig:metric_corr}{{20}{69}{This plot illustrates a clustered correlation matrix of the metrics, according to max values players accrued over their careers. \relax }{figure.caption.66}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces We see that there is a separation of players by position type, much like the PCA plot. \relax }}{70}{figure.caption.70}\protected@file@percent }
\newlabel{fig:cov_matrix}{{21}{70}{We see that there is a separation of players by position type, much like the PCA plot. \relax }{figure.caption.70}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces This plot illustrates the average value of production by age, across a variety of different metrics, smoothed by a LOESS estimator. Note that some of these estimates do not respect aging beliefs (i.e some metrics indicate infinite improvement with respect to age, as well as a decrease then improvement). This observation can be explained by selection bias; players who are more successful are likely to play later in their careers, and tend to have higher values of production, biasing curves upwards. \relax }}{70}{figure.caption.71}\protected@file@percent }
\newlabel{fig:empirical_production}{{22}{70}{This plot illustrates the average value of production by age, across a variety of different metrics, smoothed by a LOESS estimator. Note that some of these estimates do not respect aging beliefs (i.e some metrics indicate infinite improvement with respect to age, as well as a decrease then improvement). This observation can be explained by selection bias; players who are more successful are likely to play later in their careers, and tend to have higher values of production, biasing curves upwards. \relax }{figure.caption.71}{}}
