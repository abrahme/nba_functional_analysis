\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces We can see the hold-out coverage as we move further from the end of our in-sample dataset. We see that coverage slightly dips as we move further into the future, but not significantly.\relax }}{67}{figure.caption.64}\protected@file@percent }
\newlabel{fig:coverage_yearly}{{18}{67}{We can see the hold-out coverage as we move further from the end of our in-sample dataset. We see that coverage slightly dips as we move further into the future, but not significantly.\relax }{figure.caption.64}{}}
