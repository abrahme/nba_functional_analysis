\newlabel{fig:concave_loadings_intervals}{{25}{63}{Posterior distributions of the per-basis root-mean-square loading $\sqrt {G_{k,ll}}$ for each metric (points: posterior medians; intervals: 66\% and 95\%). Because $G_k$ is gauge-invariant, these intervals combine draws across chains without sign or rotation alignment.\relax }{figure.caption.70}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {7.13}Graphical Model}{63}{subsection.7.13}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {26}{\ignorespaces Canonical concave curves by metric: the $M$ eigen-components of each metric's posterior-mean Gram matrix $\bar  G_k$, pushed through the peak-parameterized quadratic form (Equation~\ref  {eq:max_constraint_gp}) anchored at the metric's posterior-mean peak age and scaled by their $\alpha $-normalized loadings $\xi ^k_j / \alpha _k$, so line heights are each component's contribution to the metric's population-mean descent. Together with their loadings the components reconstruct that curvature exactly (Equation~\ref  {eq:canonical_decomp}). Components are metric-specific: the colour legend indexes each metric's own eigen-order, so a given colour does not denote the same curve across panels.\relax }}{64}{figure.caption.71}\protected@file@percent }
\newlabel{fig:concave_canonical_curves}{{26}{64}{Canonical concave curves by metric: the $M$ eigen-components of each metric's posterior-mean Gram matrix $\bar G_k$, pushed through the peak-parameterized quadratic form (Equation~\ref {eq:max_constraint_gp}) anchored at the metric's posterior-mean peak age and scaled by their $\alpha $-normalized loadings $\xi ^k_j / \alpha _k$, so line heights are each component's contribution to the metric's population-mean descent. Together with their loadings the components reconstruct that curvature exactly (Equation~\ref {eq:canonical_decomp}). Components are metric-specific: the colour legend indexes each metric's own eigen-order, so a given colour does not denote the same curve across panels.\relax }{figure.caption.71}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {27}{\ignorespaces Posterior-mean energy share of each canonical curvature component by metric (rows sum to 1). A metric whose share concentrates on component 1 has an essentially one-dimensional curvature profile --- a single canonical concave shape scaled across players --- while mass on later components indicates genuinely multi-modal bending across the population. Shares are within-metric quantities: they are comparable across metrics as concentration measures even though the components themselves differ per metric.\relax }}{65}{figure.caption.72}\protected@file@percent }
\newlabel{fig:canonical_loadings_heatmap}{{27}{65}{Posterior-mean energy share of each canonical curvature component by metric (rows sum to 1). A metric whose share concentrates on component 1 has an essentially one-dimensional curvature profile --- a single canonical concave shape scaled across players --- while mass on later components indicates genuinely multi-modal bending across the population. Shares are within-metric quantities: they are comparable across metrics as concentration measures even though the components themselves differ per metric.\relax }{figure.caption.72}{}}
\@writefile{lot}{\contentsline {table}{\numberline {45}{\ignorespaces Observational model description. We group metrics into different observation models: Gaussian ($\mathcal  {G}$), Binomial ($\mathcal  {B}$), Poisson ($\mathcal  {C}$), Negative-Binomial ($\mathcal  {R}$), Beta ($\mathcal  {P}$), and Beta-Binomial. $\mathcal  {G} =$ \{OBPM, DBPM\}, $\mathcal  {B} =$ \{FG2M, FG3M, FTM\}, $\mathcal  {C} =$ \{BLK, STL, AST, DREB, OREB, TOV\}, $\mathcal  {R} =$ \{FTA, FG2A, FG3A\}, $\mathcal  {P} =$ \{USG, PCT\_MIN\}; games played is Beta-Binomial and minutes-per-game is scaled Beta.\relax }}{65}{table.caption.80}\protected@file@percent }
\newlabel{tab:metric_description}{{45}{65}{Observational model description. We group metrics into different observation models: Gaussian ($\mathcal {G}$), Binomial ($\mathcal {B}$), Poisson ($\mathcal {C}$), Negative-Binomial ($\mathcal {R}$), Beta ($\mathcal {P}$), and Beta-Binomial. $\mathcal {G} =$ \{OBPM, DBPM\}, $\mathcal {B} =$ \{FG2M, FG3M, FTM\}, $\mathcal {C} =$ \{BLK, STL, AST, DREB, OREB, TOV\}, $\mathcal {R} =$ \{FTA, FG2A, FG3A\}, $\mathcal {P} =$ \{USG, PCT\_MIN\}; games played is Beta-Binomial and minutes-per-game is scaled Beta.\relax }{table.caption.80}{}}
\citation{Solin_2019}
\@writefile{lof}{\contentsline {figure}{\numberline {28}{\ignorespaces Posterior-mean correlation between metrics' population-mean curvature functions $c_k(t) = \boldsymbol  \psi (t)^\top G_k \boldsymbol  \psi (t)$, computed over the observed age grid within each posterior draw and averaged across draws; rows and columns are ordered by complete-linkage hierarchical clustering of the distance $1 - r$, so metrics sit together exactly when their curvature shapes correlate highly. High values indicate metrics whose production bends with age in the same shape. Because every $c_k$ is non-negative and grows away from the peak, a positive baseline is structural to concavity; the relative ordering is the signal. GP\% is nearly uncorrelated with USG and OBPM --- availability ages on its own schedule --- while the rate and defensive metrics form a tight cluster and OBPM pairs with USG.\relax }}{66}{figure.caption.73}\protected@file@percent }
\newlabel{fig:curvature_metric_corr}{{28}{66}{Posterior-mean correlation between metrics' population-mean curvature functions $c_k(t) = \boldsymbol \psi (t)^\top G_k \boldsymbol \psi (t)$, computed over the observed age grid within each posterior draw and averaged across draws; rows and columns are ordered by complete-linkage hierarchical clustering of the distance $1 - r$, so metrics sit together exactly when their curvature shapes correlate highly. High values indicate metrics whose production bends with age in the same shape. Because every $c_k$ is non-negative and grows away from the peak, a positive baseline is structural to concavity; the relative ordering is the signal. GP\% is nearly uncorrelated with USG and OBPM --- availability ages on its own schedule --- while the rate and defensive metrics form a tight cluster and OBPM pairs with USG.\relax }{figure.caption.73}{}}
