\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Graphical model for \texttt  {ConvexMaxInjuryTVLinearLVM}. Shaded nodes are observed; unshaded nodes are latent. $X_p \sim \mathcal  {N}(0,I_D)$: latent player embedding (identity projection). $\nu ^k, w^k$: weight vectors for peak age and peak value; $t^*_{pk} = X_p^\top \nu ^k$ and $f^*_{pk} = X_p^\top w^k$. $f^k(X_p,t)$: HSGP concave trajectory parameterised by spectral weights $\beta $ and the linear projection of $X_p$. $r^k_{pt}$: AR(1) residual. $\tau ^k_{ptm}$: injury offset with prior mean $\mu _0^k + L_k^\top F_m + X_p^\top W_\tau ^{km}$. $Y^k_{pt}$: observed statistic (Gaussian, Negative-Binomial, Beta, or Beta-Binomial).\relax }}{29}{figure.caption.23}\protected@file@percent }
\newlabel{fig:graphical_model}{{11}{29}{Graphical model for \texttt {ConvexMaxInjuryTVLinearLVM}. Shaded nodes are observed; unshaded nodes are latent. $X_p \sim \mathcal {N}(0,I_D)$: latent player embedding (identity projection). $\nu ^k, w^k$: weight vectors for peak age and peak value; $t^*_{pk} = X_p^\top \nu ^k$ and $f^*_{pk} = X_p^\top w^k$. $f^k(X_p,t)$: HSGP concave trajectory parameterised by spectral weights $\beta $ and the linear projection of $X_p$. $r^k_{pt}$: AR(1) residual. $\tau ^k_{ptm}$: injury offset with prior mean $\mu _0^k + L_k^\top F_m + X_p^\top W_\tau ^{km}$. $Y^k_{pt}$: observed statistic (Gaussian, Negative-Binomial, Beta, or Beta-Binomial).\relax }{figure.caption.23}{}}
