\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Directed acyclic graph of the complete generative model. Shaded nodes are observed; unshaded nodes are latent. $Z_p, W$: structured prior mean $Z_p^\top W$ anchoring $X_p$ to draft position, height, and positional role. $\phi (\cdot )$: feature-map projection applied to the embedding before it enters the concave process, chosen so that $\phi (X_p)^\top \phi (X_{p'})\approx \mathcal  {K}(X_p,X_{p'})$ --- the identity map $\phi (X_p)=X_p$ recovers the linear GPLVM, while random Fourier features (or another feature map) approximate a nonlinear kernel; $\theta _\phi $ collects its hyperparameters (kernel lengthscale and, for random features, the sampled frequencies). $\nu ^k, w^k$: weight vectors reading peak age $t^*_{pk}$ and peak value $f^*_{pk}$ from the embedding. $\beta $: HSGP spectral weights for the concave trajectory $f^k(\phi (X_p),t)$. $\rho ^k, \sigma ^k_{AR}$: AR(1) parameters for the player-metric residual $r^k_{pt}$. $F_m, L_k$: injury-type factors and metric loadings for the injury offset $\tau ^k_{ptm}$. $Y^k_{pt}$: observed statistic (Gaussian, Negative-Binomial, Beta, or Beta-Binomial, per Table~\ref  {tab:metric_description}).\relax }}{26}{figure.caption.17}\protected@file@percent }
\newlabel{fig:graphical_model}{{11}{26}{Directed acyclic graph of the complete generative model. Shaded nodes are observed; unshaded nodes are latent. $Z_p, W$: structured prior mean $Z_p^\top W$ anchoring $X_p$ to draft position, height, and positional role. $\phi (\cdot )$: feature-map projection applied to the embedding before it enters the concave process, chosen so that $\phi (X_p)^\top \phi (X_{p'})\approx \mathcal {K}(X_p,X_{p'})$ --- the identity map $\phi (X_p)=X_p$ recovers the linear GPLVM, while random Fourier features (or another feature map) approximate a nonlinear kernel; $\theta _\phi $ collects its hyperparameters (kernel lengthscale and, for random features, the sampled frequencies). $\nu ^k, w^k$: weight vectors reading peak age $t^*_{pk}$ and peak value $f^*_{pk}$ from the embedding. $\beta $: HSGP spectral weights for the concave trajectory $f^k(\phi (X_p),t)$. $\rho ^k, \sigma ^k_{AR}$: AR(1) parameters for the player-metric residual $r^k_{pt}$. $F_m, L_k$: injury-type factors and metric loadings for the injury offset $\tau ^k_{ptm}$. $Y^k_{pt}$: observed statistic (Gaussian, Negative-Binomial, Beta, or Beta-Binomial, per Table~\ref {tab:metric_description}).\relax }{figure.caption.17}{}}
\newlabel{eq:eta}{{18}{26}{Career Duration Formulation}{equation.7.18}{}}
