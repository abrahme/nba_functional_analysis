\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Posterior production curves for Stephen Curry: joint model (left) vs.\ Naive AR baseline (right). The joint model yields markedly tighter credible intervals by sharing information across metrics and players. Green line = posterior mean concave curve; red dashed line = training cutoff.\relax }}{17}{figure.caption.3}\protected@file@percent }
\newlabel{fig:posterior_curves}{{2}{17}{Posterior production curves for Stephen Curry: joint model (left) vs.\ Naive AR baseline (right). The joint model yields markedly tighter credible intervals by sharing information across metrics and players. Green line = posterior mean concave curve; red dashed line = training cutoff.\relax }{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}The Benefits of Joint Modeling}{17}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Posterior production curves for Nikola Joki\'{c}: joint model (left) vs.\ Naive AR baseline (right). The joint model yields tighter, structurally coherent credible intervals by pooling information across all 17 metrics simultaneously. Green line = posterior mean; red dashed line = training cutoff.\relax }}{18}{figure.caption.4}\protected@file@percent }
\newlabel{fig:jokic_comparison}{{3}{18}{Posterior production curves for Nikola Joki\'{c}: joint model (left) vs.\ Naive AR baseline (right). The joint model yields tighter, structurally coherent credible intervals by pooling information across all 17 metrics simultaneously. Green line = posterior mean; red dashed line = training cutoff.\relax }{figure.caption.4}{}}
